# ===== ゲートウェイ（npm run gateway）=====
PORT=8787
# 買い手から見たゲートウェイの公開URL（Nevermined の paymentRequired.resource.url に入る）
PUBLIC_BASE_URL=http://localhost:8787

# Nevermined。最初は sandbox のみ（キーの接頭辞と NVM_ENVIRONMENT が一致しないと起動しない）
NVM_ENVIRONMENT=sandbox
# 売り手（ゲートウェイ運営者）のキー
NVM_API_KEY_SELLER=sandbox:xxxxxxxx
# 買い手（利用者）のキー。plan:order / buyer:token / payg:probe で使う
NVM_API_KEY_BUYER=sandbox:xxxxxxxx
# エージェント登録後の ID（npm run plan:register -- --plan-id <ID> の出力）
NVM_AGENT_ID=
# Nevermined App で作った prepaid-100（$1・100 クレジット・30日有効）のプラン ID
NVM_PLAN_ID=
# payg 試験でプランを登録するときの受取アドレス（payg:probe でのみ使用）
NVM_RECEIVER_ADDRESS=0x...

# 裏側の x402 エンドポイント（テスト用の URL）。OSD・JIN 側は変更しない。価格・チェーンは config/pricing.json に反映する
UPSTREAM_JIN_URL=https://jin.example.test
UPSTREAM_OSD_URL=https://osd.example.test

# ゲートウェイ専用の新しいウォレット（AA のウォレットは使わない）。npm run wallet:new で作る
# Solana: base58 の 64 バイト秘密鍵（devnet USDC を入金する）
GATEWAY_WALLET_SECRET=
# EVM（Base）も使う場合のみ（npm run wallet:new -- --evm）
GATEWAY_EVM_PRIVATE_KEY=

# 支払い上限。src/config.ts の上限（$0.05 / $5）より下げることだけできる
# MAX_USD_PER_CALL=0.05
# MAX_USD_PER_DAY=5

# true（既定）の間は、テストネットの USDC にしか支払わない
UPSTREAM_TESTNET_ONLY=true
# 本番（live / メインネット）を許可する。docs/go-live.md の条件を満たすまで false のまま
ALLOW_LIVE=false

# true（既定）: 残高不足なら settle せずゲートウェイが 402 を返す（カードへの自動補充を起こさない）
# false: Nevermined 自身の残高切れの挙動（自動補充・委任上限での拒否）を測る週に使う
BLOCK_CARD_TOPUP=true

# ログ匿名化の塩（ランダムな文字列）
LOG_SALT=change-me

# ===== ゲートウェイのログ =====
# blob（既定）: Vercel Blob の log/YYYY-MM-DD.jsonl（JST の日付）に追記
# file: ローカルの $LOG_DIR/YYYY-MM-DD.jsonl（開発時のみ。NODE_ENV=development のときだけ有効。Sandbox の運用でも使わない）
LOG_SINK=blob
# Vercel の Storage > Blob で作ったストアの読み書きトークン（ゲートウェイだけが持つ）
BLOB_READ_WRITE_TOKEN=
# 実証2用の GET /logs/:date の Bearer トークン（32文字以上。npm run logs:issue-read-token で生成）。未設定なら口を閉じる
LOG_READ_TOKEN=
# 開発時のゲートウェイのログ、および買い手・スクリプトのローカル記録の置き場
LOG_DIR=log

# ===== 買い手エージェント（npm run buyer）=====
GATEWAY_URL=http://localhost:8787
# scripts/buyer-token.ts で発行したトークン
NVM_ACCESS_TOKEN=
BUYER_CALLS_PER_DAY=20
# BUYER_INTERVAL_SEC=4320
BUYER_JIN_PATH=/jin/series
BUYER_OSD_PATH=/osd/catalysts/AAPL
# stop（既定：停止して通知）| wait（通知して次の間隔で再試行）
BUYER_ON_EXHAUSTED=stop
# Slack 互換の Incoming Webhook（任意）
NOTIFY_WEBHOOK_URL=

# ===== 買い手のトークン発行（npm run buyer:token、NVM_API_KEY_BUYER で実行）=====
# 委任は buyer:token が作る（有効なものがあれば再利用）。通貨 usd、上限は 100¢（コードに固定）
# 下げるときだけ設定する（50〜100）
# BUYER_DELEGATION_LIMIT_CENTS=100
# 委任に使うカードの事業者（Nevermined App で登録済みのもの）
# BUYER_CARD_PROVIDER=stripe

# ===== payg の試験（npm run payg:probe、Sandbox で1回だけ）=====
# NVM_API_KEY_SELLER / NVM_API_KEY_BUYER（上）を使う。買い手には Stripe のテストカードを登録しておく
# 登録済みなら指定（未指定なら試験の中で登録を試みる）
NVM_PLAN_ID_PAYG=
# BUYER_CARD_PROVIDER=stripe

# ===== 週次集計（GATEWAY_URL と LOG_READ_TOKEN があれば GET /logs/:date から読む）=====
# GATEWAY_URL / LOG_READ_TOKEN は上と同じ
# CHAIN_FEE_USD_PER_TX=0
