# ===== ゲートウェイ（npm run gateway）=====
PORT=8787
# 買い手から見たゲートウェイの公開URL（Nevermined の paymentRequired.resource.url に入る）
PUBLIC_BASE_URL=http://localhost:8787

# Nevermined（売り手＝ゲートウェイ運営者のキー）。最初は sandbox のみ
NVM_ENVIRONMENT=sandbox
NVM_API_KEY=sandbox:xxxxxxxx
NVM_AGENT_ID=
NVM_PLAN_ID=
# プラン登録時の受取アドレス（scripts/register-plan.ts で使用）
NVM_RECEIVER_ADDRESS=0x...

# 裏側の x402 エンドポイント（テスト環境の URL）。OSD・JIN 側は変更しない
OSD_BASE_URL=https://osd.example.test
JIN_BASE_URL=https://jin.example.test

# ゲートウェイ専用の新しいウォレット（AA のウォレットは使わない）。片方だけでもよい
# EVM: 0x で始まる秘密鍵 / Solana: base58 の 64 バイト秘密鍵
GATEWAY_EVM_PRIVATE_KEY=
GATEWAY_SVM_PRIVATE_KEY=

# 支払い上限。src/config.ts の上限（$0.05 / $5）より下げることだけできる
# MAX_USD_PER_CALL=0.05
# MAX_USD_PER_DAY=5

# true（既定）の間は、テストネットの USDC にしか支払わない
UPSTREAM_TESTNET_ONLY=true
# 本番（live / メインネット）を許可する。docs/go-live.md の条件を満たすまで false のまま
ALLOW_LIVE=false

# ログ匿名化の塩（ランダムな文字列）
LOG_SALT=change-me
LOG_DIR=log

# ===== 買い手エージェント（npm run buyer）=====
GATEWAY_URL=http://localhost:8787
# scripts/buyer-token.ts で発行したトークン
NVM_ACCESS_TOKEN=
BUYER_CALLS_PER_DAY=20
# BUYER_INTERVAL_SEC=4320
BUYER_JIN_PATH=/jin/series
BUYER_OSD_PATH=/osd/catalysts/AAPL
# stop（既定：停止して通知）| wait（通知して次の間隔で再試行）
BUYER_ON_EXHAUSTED=stop
# Slack 互換の Incoming Webhook（任意）
NOTIFY_WEBHOOK_URL=

# ===== 買い手のトークン発行（npm run buyer:token、買い手の NVM_API_KEY で実行）=====
# Nevermined App でカードを登録し、小さい上限で作った委任の ID
NVM_DELEGATION_ID=
# NVM_TOKEN_SCHEME=nvm:card-delegation

# ===== 週次集計 =====
# CHAIN_FEE_USD_PER_TX=0
