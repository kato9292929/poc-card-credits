{
  "name": "poc-card-credits",
  "version": "0.1.0",
  "private": true,
  "description": "PoC 1: card-funded Nevermined credits consumed per-call by agents, backed by x402 purchases of OSD / JIN",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gateway": "tsx src/gateway/server.ts",
    "buyer": "tsx agents/buyer/index.ts",
    "plan:register": "tsx scripts/register-plan.ts",
    "plan:order": "tsx scripts/order-plan.ts",
    "buyer:token": "tsx scripts/buyer-token.ts",
    "report:weekly": "tsx scripts/weekly-report.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "wallet:new": "tsx scripts/new-wallet.ts",
    "logs:issue-read-token": "tsx scripts/issue-log-read-token.ts",
    "payg:probe": "tsx scripts/payg-probe.ts",
    "preflight": "tsx scripts/preflight.ts"
