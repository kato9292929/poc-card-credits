    {
      "id": "jin.series",
      "method": "GET",
      "path": "/jin/series",
      "upstream": "jin",
      "upstreamPath": "/jin/series",
      "priceUsd": "0.01",
      "credits": 1
    },
    {
      "id": "jin.movers",
      "method": "GET",
      "path": "/jin/movers",
      "upstream": "jin",
      "upstreamPath": "/jin/movers",
      "priceUsd": "0.02",
      "credits": 2
    },
    {
      "id": "osd.catalysts",
      "method": "GET",
      "path": "/osd/catalysts/:ticker",
      "upstream": "osd",
      "upstreamPath": "/osd/catalysts/:ticker",
      "priceUsd": "0.01",
      "credits": 1
    }
  ]
}
